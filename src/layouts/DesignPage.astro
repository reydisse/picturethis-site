---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/doop.css';
import enquiryForm from '../design/enquiry-form.html?raw';
import { withEnquiryConfig } from '../lib/enquiry';
const {title,design,description}=Astro.props;
---
<!doctype html><html lang="en-CA"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" type="image/png" href="/favicon.png" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/><title>{title} | PictureThis Production</title>{description && <meta name="description" content={description}/>}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"/><style set:html={design.css}/><link rel="stylesheet" href="/responsive.css"/><link rel="stylesheet" href="/enquiry.css"/></head><body id="top"><a class="skip" href="#main">Skip to content</a><SiteHeader/><main id="main" set:html={withEnquiryConfig(design.html.replace('<!-- enquiry-form -->', () => enquiryForm))}/><SiteFooter/><script is:inline>document.querySelectorAll('.faq-q').forEach(b=>b.addEventListener('click',()=>{const p=b.closest('.faq');const open=p.dataset.state!=='open';p.dataset.state=open?'open':'closed';b.setAttribute('aria-expanded',String(open))}));</script><script src="/enquiry.js" defer></script>
<script is:inline>
// Gift picker (Get Involved): the chosen amount carries through to the Donate page.
document.querySelectorAll('section:has(.amt)').forEach(section => {
 const buttons = [...section.querySelectorAll('.amt')];
 const input = section.querySelector('input[inputmode="decimal"]');
 const link = section.querySelector('a[href^="/donate/"]');
 const label = link.querySelector('span');
 const summary = document.createElement('p');
 summary.setAttribute('aria-live', 'polite');
 link.parentElement.after(summary);
 const update = (amount, impact) => {
  label.textContent = amount > 0 ? `Donate $${amount.toLocaleString('en-CA', {maximumFractionDigits:2})}` : 'Choose a gift amount';
  link.href = amount > 0 ? `/donate/?amount=${encodeURIComponent(amount)}#pledge` : '/donate/#pledge';
  summary.textContent = impact;
 };
 buttons.forEach(button => button.addEventListener('click', () => {
  input.value = '';
  buttons.forEach(b => {b.dataset.state = b === button ? 'selected' : 'default'; b.setAttribute('aria-pressed', String(b === button));});
  update(Number(button.querySelector('.amt-v').textContent.replace('$','')), button.querySelector('.amt-u').textContent);
 }));
 input.addEventListener('input', () => {
  buttons.forEach(b => {b.dataset.state = 'default'; b.setAttribute('aria-pressed','false');});
  const amount = Number(input.value.replace(/[$,\s]/g,''));
  update(Number.isFinite(amount) && amount > 0 ? amount : 0, amount > 0 ? 'Your gift supports free training, transit and the shared gear library.' : 'Enter a positive amount in CAD or choose a preset.');
 });
 const selected = buttons.find(b => b.dataset.state === 'selected');
 if (selected) selected.click();
});
</script></body></html>
