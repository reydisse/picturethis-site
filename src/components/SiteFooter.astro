---
import {contactEmail} from '../config';
const groups=[['Explore',['Programs','Faithfire','Projects','Blog']],['Participate',['Events','Partners','Get Involved']],['Support',['Donate','Our standards & policies']]];
---
<footer class="site-footer"><div><h3>PictureThis Production</h3><p>PictureThis Production is being set up as a nonprofit organization in Ontario.</p><p>Faithfire Production is its production arm.</p><p>Training: Faithfire Production, 139 Millwick Dr, Toronto.</p><a href={'mailto:'+contactEmail}>{contactEmail}</a><p>Placeholder contact</p></div>{groups.map(([title,items])=><div><h3>{title}</h3>{(items as string[]).map(label=><a href={'/'+(label==='Our standards & policies'?'policies':label.toLowerCase().replaceAll(' ','-'))+'/'}>{label}</a>)}</div>)}<a href="#top">Back to top ↑</a></footer>