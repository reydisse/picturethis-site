---
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
const related=(await getCollection('blog',({data})=>!data.draft)).filter(x=>x.id!==post.id).slice(0,2);
---
<Site title={post.data.title}><article>{post.data.photo && <figure><img loading="lazy" decoding="async" loading="lazy" decoding="async" src={post.data.photo} alt={post.data.title + " — production crew at work"}/><figcaption>{post.data.photo_caption}</figcaption></figure>}<h1>{post.data.title}</h1><p>{post.data.author}</p><div class="article-content"><Content/></div><aside class="invitation"><h2>Join a cohort</h2><p>Open to everyone under Who we serve: young people ages 16 to 29, young people starting over after the justice system, people in recovery, women, families, and people with disabilities. No experience needed. Applications are open for January.</p><a href="/get-involved/">Get involved</a></aside>{related.map(x=><p><a href={"/blog/"+x.id+"/"}>{x.data.title}</a></p>)}</article></Site>
