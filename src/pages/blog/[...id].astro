---
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('blog',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
const related=(await getCollection('blog',({data})=>!data.draft)).filter(x=>x.id!==post.id).slice(0,2);
const {title,summary,author,date,photo,photo_caption}=post.data;
const published=date?.toLocaleDateString('en-CA',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'});
---
<Site title={title} description={summary}>
  <article class="post">
    <a class="post-back" href="/blog/">← All articles</a>
    <div class="post-head">
      <h1>{title}</h1>
      <p class="post-meta">{author}{published && <> · <time datetime={date.toISOString().slice(0,10)}>{published}</time></>}</p>
    </div>
    {photo && <figure class="post-photo"><img decoding="async" src={photo} alt=""/>{photo_caption && <figcaption>{photo_caption}</figcaption>}</figure>}
    <div class="article-content"><Content/></div>
    <aside class="invitation"><h2>Join a cohort</h2><p>Open to everyone we serve: young people ages 16 to 29, young people starting over after the justice system, people in recovery, women, families, and people with disabilities. No experience needed. Applications are open for January.</p><a href="/get-involved/">Get involved</a></aside>
    {related.length > 0 && <section class="related" aria-labelledby="related-title"><h2 id="related-title">More from the crew room</h2><ul>{related.map(x=><li><a href={"/blog/"+x.id+"/"}>{x.data.title}</a>{x.data.summary && <p>{x.data.summary}</p>}</li>)}</ul></section>}
  </article>
</Site>
