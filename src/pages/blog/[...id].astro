---
import PostCard from '../../components/PostCard.astro';
import Site from '../../layouts/Site.astro';
import { render } from 'astro:content';
import { formatDate, publishedPosts, readingMinutes, type Post } from '../../lib/blog';
export async function getStaticPaths(){ return (await publishedPosts()).map(post=>({params:{id:post.id},props:{post}})); }
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const related = (await publishedPosts()).filter(x=>x.id!==post.id).slice(0,2);
const { title, summary, author, date, photo, photo_caption, pull_quote } = post.data;
const published = formatDate(date);
// Only feature the pull quote when the article doesn't already open with the same words.
const norm = (text = '') => text.replace(/[*_’']/g, '').replace(/\s+/g, ' ').trim().toLowerCase();
const showQuote = pull_quote && !norm(post.body).includes(norm(pull_quote));
---
<Site title={title} description={summary}>
  <article class="article">
    <div class="article-hero">
      <a class="article-back" href="/blog/">← All articles</a>
      <p class="article-kicker">Blog{published && <> · <time datetime={date!.toISOString().slice(0,10)}>{published}</time></>} · {readingMinutes(post)} min read</p>
      <h1>{title}</h1>
      {summary && <p class="article-lede">{summary}</p>}
      {author && <p class="article-byline">By {author}</p>}
    </div>
    {photo && <figure class="article-photo"><img decoding="async" src={photo} alt=""/>{photo_caption && <figcaption>{photo_caption}</figcaption>}</figure>}
    <div class="article-body">
      {showQuote && <blockquote class="article-quote"><p>{pull_quote}</p></blockquote>}
      <div class="article-content"><Content/></div>
      <aside class="article-cta" aria-labelledby="cta-title">
        <h2 id="cta-title">Join a cohort</h2>
        <p>Open to everyone we serve: young people ages 16 to 29, young people starting over after the justice system, people in recovery, women, families, and people with disabilities. No experience needed. Applications are open for January.</p>
        <a class="article-cta-button" href="/get-involved/#join">Apply for the January cohort</a>
      </aside>
    </div>
  </article>
  {related.length > 0 && (
    <section class="article-related" aria-labelledby="related-title">
      <h2 id="related-title">More from the crew room</h2>
      <div class="post-grid post-grid-2">{related.map(x => <PostCard post={x} headingLevel={3}/>)}</div>
    </section>
  )}
</Site>
