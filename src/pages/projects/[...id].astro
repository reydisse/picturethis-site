---
import PageHero from "../../components/PageHero.astro";
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
const related=(await getCollection('projects',({data})=>!data.draft)).filter(x=>x.id!==post.id).slice(0,3);
const {title,summary,type,status,photo,photo_caption,pull_quote}=post.data;
---
<Site title={title} description={summary}>
  <PageHero eyebrow="Projects" title={title}/>
  <article class="post">
    <nav class="breadcrumb eyebrow" aria-label="Breadcrumb"><a href="/projects/">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    {(type || status) && <p class="post-meta">{[type, status].filter(Boolean).join(" · ")}</p>}
    {photo && <figure class="post-photo"><img decoding="async" src={photo} alt=""/>{photo_caption && <figcaption>{photo_caption}</figcaption>}</figure>}
    {pull_quote && <blockquote>{pull_quote}</blockquote>}
    <div class="article-content"><Content/></div>
    <aside class="invitation"><h2>Be part of the next one</h2><p>Join a cohort, mentor, or bring your team to a training day.</p><a href="/get-involved/">Get involved</a></aside>
    {related.length > 0 && <section class="related" aria-labelledby="related-title"><h2 id="related-title">More projects</h2><ul>{related.map(x=><li><a href={"/projects/"+x.id+"/"}>{x.data.title}</a></li>)}</ul></section>}
  </article>
</Site>
