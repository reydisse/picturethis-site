---
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
const related=(await getCollection('projects',({data})=>!data.draft)).filter(x=>x.id!==post.id).slice(0,3);
---
<Site title={post.data.title} nextLinks={["Faithfire","Events","Get Involved"]}><article><nav class="breadcrumb eyebrow" aria-label="Breadcrumb"><a href="/projects/">Projects</a><span>/</span><span>{post.data.title}</span></nav><h1>{post.data.title}</h1><p>{post.data.author}</p>{!post.data.photo && <figure class="production-photo"><img src="https://doop.design/photos/pexels/13312280.jpeg?h=900&w=1600" alt="Stage spotlights at a live event"/><figcaption>Illustrative photography.</figcaption></figure>}{post.data.photo && <figure><img src={post.data.photo} alt=""/><figcaption>{post.data.photo_caption}</figcaption></figure>}{post.data.pull_quote && <blockquote>{post.data.pull_quote}</blockquote>}<Content/><aside><a href="/get-involved/">Get involved</a></aside>{related.map(x=><p><a href={"/projects/"+x.id+"/"}>{x.data.title}</a></p>)}</article></Site>