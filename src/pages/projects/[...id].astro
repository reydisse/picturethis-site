---
import PageHero from "../../components/PageHero.astro";
import Site from '../../layouts/Site.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('projects',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
const related=(await getCollection('projects',({data})=>!data.draft)).filter(x=>x.id!==post.id).slice(0,3);
---
<Site title={post.data.title} nextLinks={["Faithfire","Events","Get Involved"]}><PageHero eyebrow="Projects" title={post.data.title} id="28643184" alt="Production training and event equipment"/><article><nav class="breadcrumb eyebrow" aria-label="Breadcrumb"><a href="/projects/">Projects</a><span>/</span><span>{post.data.title}</span></nav><p>{post.data.author}</p>{post.data.photo && <figure><img loading="lazy" decoding="async" loading="lazy" decoding="async" src={post.data.photo} alt=""/><figcaption>{post.data.photo_caption}</figcaption></figure>}{post.data.pull_quote && <blockquote>{post.data.pull_quote}</blockquote>}<Content/><aside><a href="/get-involved/">Get involved</a></aside>{related.map(x=><p><a href={"/projects/"+x.id+"/"}>{x.data.title}</a></p>)}</article></Site>