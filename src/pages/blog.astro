---
import Site from '../layouts/Site.astro';
import {getCollection} from 'astro:content';
const posts=await getCollection('blog', ({data})=>!data.draft);
---
<Site><section class="page-opening"><figure class="production-photo"><img src="https://doop.design/photos/pexels/28643185.jpeg?h=900&w=1600" alt="Sound engineer operating an outdoor mixing console" loading="lazy"/><figcaption>Illustrative photography</figcaption></figure><h1>Blog</h1>{posts.length===0 && <p>No stories are published yet.</p>}<div class="cards">{posts.map(post=><article><a href={"/blog/"+post.id+"/"}>{post.data.photo && <figure><img src={post.data.photo} alt=""/><figcaption>{post.data.photo_caption}</figcaption></figure>}<h2>{post.data.title}</h2></a><p>{post.data.summary}</p></article>)}</div></section></Site>