---
import Site from '../layouts/Site.astro';
import {getCollection} from 'astro:content';
const posts=await getCollection('events', ({data})=>!data.draft);
---
<Site><section><h1>Events</h1><div class="cards">{posts.map(post=><article><a href={"/events/"+post.id+"/"}>{post.data.photo && <figure><img src={post.data.photo} alt=""/><figcaption>{post.data.photo_caption}</figcaption></figure>}<h2>{post.data.title}</h2></a><p>{post.data.summary}</p></article>)}</div></section></Site>