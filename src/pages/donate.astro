---
import PageHero from "../components/PageHero.astro";
import Site from "../layouts/Site.astro";
import { contactEmail, donationUrl, formEndpoint } from "../config";

// Keep these in step with the gift picker on Get Involved.
const gifts = [
  { amount: 40, title: "Course materials", text: "Course materials for one participant, all eight weeks." },
  { amount: 90, title: "Transit", text: "A month of TTC fares so a participant can get to training." },
  { amount: 250, title: "Gear library", text: "Cables, repairs and replacements for the shared gear library." },
];
const online = donationUrl !== "";
---
<Site title="Donate" description="Keep PictureThis free. Your gift covers course materials, TTC fares and the shared gear library for young people training in live production across the GTA.">
  <link slot="head" rel="stylesheet" href="/enquiry.css"/>
  <PageHero eyebrow="Donate" title="Keep the course free."/>
  <section class="page-opening donate-opening">
    <p class="lead">Partners and donors cover the costs; participants pay nothing, ever. Every gift goes to what gets a young person to training and onto a crew.</p>
    {online
      ? <a class="button" href={donationUrl}>Donate online</a>
      : <p class="donate-status" role="note"><strong>Online giving opens soon.</strong> Until then, pledge your gift below and we will reply within a week with how to complete it. We never ask for card or banking details by email.</p>}
  </section>

  <section aria-labelledby="gifts-title">
    <h2 id="gifts-title">What a gift does</h2>
    <div class="gift-grid">
      {gifts.map((gift) => (
        <a class="gift-card" href={online ? donationUrl : `/donate/?amount=${gift.amount}#pledge`} data-gift-amount={gift.amount}>
          <h3><span>${gift.amount}</span>{gift.title}</h3>
          <p>{gift.text}</p>
          <p class="gift-cta">{online ? "Donate online" : `Pledge $${gift.amount}`}<span aria-hidden="true"> →</span></p>
        </a>
      ))}
    </div>
  </section>

  {!online && (
    <section id="pledge" class="pledge" aria-labelledby="pledge-title">
      <div>
        <h2 id="pledge-title">Pledge a gift</h2>
        <p>Tell us what you would like to give. Nothing is charged here: we email you to arrange it, and once online giving opens we will send you the link.</p>
        <p>Monthly gifts keep the program free for the next cohort. Every amount is reported in our annual update: what came in, what it bought, who it trained.</p>
      </div>
      <form class="redesign-enquiry" aria-label="Pledge a gift" novalidate data-enquiry-form data-designed-status
        data-endpoint={formEndpoint} data-contact={contactEmail}
        data-subject="Gift pledge: ${amount} CAD, {frequency}"
        data-success="Thank you! Your pledge has been sent. We will email you within a week with how to complete your gift.">
        <label class="fld"><span class="lab">Your name</span><input class="inp" name="name" autocomplete="name" required/></label>
        <label class="fld"><span class="lab">Email address</span><input class="inp" name="email" type="email" autocomplete="email" required/></label>
        <label class="fld"><span class="lab">Amount (CAD)</span><input class="inp" name="amount" inputmode="decimal" required pattern="\$?\s*[0-9]+(\.[0-9]{1,2})?" data-error="Enter an amount in dollars, for example 90."/></label>
        <label class="fld"><span class="lab">How often</span><select class="inp" name="frequency" required><option>One-time</option><option>Monthly</option></select></label>
        <button class="btn" type="submit"><span>Send my pledge</span></button>
      </form>
    </section>
  )}

  <section class="monthly-band" aria-labelledby="gear-title">
    <h2 id="gear-title">Prefer to give gear?</h2>
    <p>Working AV equipment is welcome. We collect anywhere in the GTA.</p>
    <a href={`mailto:${contactEmail}?subject=Gear%20donation`}>Arrange a gear donation</a>
    <p class="donate-contact">Questions about giving? Email <a href={`mailto:${contactEmail}?subject=Giving%20to%20PictureThis`}>{contactEmail}</a>.</p>
  </section>
<script is:inline>
// Carry the amount chosen on Get Involved, or on a gift card, into the pledge form.
(() => {
  const form = document.querySelector('#pledge form');
  if (!form) return;
  const apply = (params) => {
    const amount = Number(String(params.get('amount') ?? '').replace(/[$,\s]/g, ''));
    if (Number.isFinite(amount) && amount > 0) form.amount.value = String(amount);
    const frequency = params.get('frequency');
    if (frequency === 'Monthly' || frequency === 'One-time') form.frequency.value = frequency;
  };
  apply(new URLSearchParams(location.search));
  document.querySelectorAll('[data-gift-amount]').forEach((card) => card.addEventListener('click', (event) => {
    event.preventDefault();
    form.amount.value = card.dataset.giftAmount;
    history.replaceState(null, '', `/donate/?amount=${card.dataset.giftAmount}#pledge`);
    document.getElementById('pledge').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    form.amount.focus({ preventScroll: true });
  }));
})();
</script>
<script src="/enquiry.js" defer></script>
</Site>
