---
import PageHero from "../components/PageHero.astro";
import ApplyBand from "../components/ApplyBand.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import NextSteps from "../components/NextSteps.astro";
import "../styles/civic.css";
import "../styles/doop.css";
import { contactEmail, formEndpoint } from "../config";
---
<!doctype html><html lang="en-CA"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Donate | PictureThis Production</title><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"/></head><body><a href="#main">Skip to content</a><SiteHeader/><main id="main"><PageHero eyebrow="Donate" title="Donate" id="34623187" alt="Hands working at a production control desk"/><section class="page-opening"><p></p></section><section><h2>One-time gifts</h2><div class="gift-grid"><article class="gift-card"><h3><span>$40</span>Course materials</h3><p>$40 covers one participant's course materials for the full eight weeks.</p></article><article class="gift-card"><h3><span>$90</span>Transit stipends</h3><p>$90 covers a term of transit stipends so a participant can actually get to training.</p></article><article class="gift-card"><h3><span>$250</span>Gear library</h3><p>$250 goes to the gear library: the shared kit participants learn on and borrow for first calls.</p></article></div><p>Donations fund the cohort program: free training for every community we serve.</p></section><section class="monthly-band"><h2>Monthly partners</h2><p>Monthly partners keep the program free for the next cohort. Every amount is reported in our annual update: what came in, what it bought, who it trained.</p></section><section><h2>Contact PictureThis</h2><p>To give, contact PictureThis at hello@picturethis-production.com.</p><a href={"mailto:"+contactEmail}>{contactEmail}</a></section><ApplyBand/></main><SiteFooter/></body></html>