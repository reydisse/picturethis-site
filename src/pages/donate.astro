import { contactEmail, formEndpoint } from "../config";
---
<!doctype html><html lang="en-CA"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Donate | PictureThis Production</title><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600&family=Archivo:wght@400;600&display=swap"/><style is:global>:root{--color-ground:#FAF7F2;--color-surface:#FFFFFF;--color-elevated:#F1E8D8;--color-ink:#221A12;--color-muted:#6F6050;--color-faint:#8A7B68;--color-accent:#D98E1E;--color-accent-soft:#FDEBC8;--color-on-accent:#1C1305;--color-line:#E2D6C2;--color-civic:#203DA5;--color-civic-soft:#EEF2FC;--color-civic-ink:#14265B;--color-civic-muted:#536185;--color-civic-line:#CCD5ED;--radius-card:18px;--radius-pill:999px;--radius-ngo:4px;--spacing-page:72px;--spacing-section:88px;--spacing-block:32px;--spacing-item:24px;--spacing-tight:16px;--font-display:Fraunces, Georgia, serif;--font-body:Archivo, Helvetica, sans-serif;--font-ngo:DM Sans, sans-serif;--font-civic:Space Grotesk, sans-serif;--text-hero:64px;--text-h1:52px;--text-h2:32px;--text-h3:20px;--text-body:16px;--text-small:13px;--text-poster:88px;--text-lead:24px}*{box-sizing:border-box}body{margin:0;background:var(--color-ground);color:var(--color-ink);font:16px/1.65 var(--font-body)}a{color:inherit}header,footer{padding:24px 5%;border-bottom:1px solid var(--color-line)}nav{display:flex;flex-wrap:wrap;gap:20px;margin-top:18px}main>section,article{padding:64px 5%}h1,h2{font-family:var(--font-display);line-height:1.1}h1{font-size:clamp(38px,5vw,64px)}h2{font-size:38px}p{max-width:850px}img{max-width:100%;object-fit:cover}figure{margin:32px 0}figure img{width:100%;max-height:480px}figcaption,small{color:var(--color-muted);font-size:13px}.row{border-top:1px solid var(--color-line);padding:24px 0}input,select,textarea{display:block;width:100%;padding:14px;margin:8px 0 20px;border:1px solid var(--color-muted);font:inherit}button,.button{display:inline-block;padding:14px 24px;background:var(--color-ink);color:var(--color-ground)}:focus-visible{outline:3px solid var(--color-civic);outline-offset:4px}@media(max-width:760px){section{grid-template-columns:1fr!important;padding:32px 5%!important;gap:24px!important}h1{font-size:42px!important}header{display:block!important}main>div{flex-wrap:wrap;gap:16px}section>div{max-width:100%}}</style></head><body><a href="#main">Skip to content</a><header><a href="/"><b>PICTURETHIS PRODUCTION</b></a><nav><a href="//">Home</a><a href="/programs/">Programs</a><a href="/faithfire/">Faithfire</a><a href="/projects/">Projects</a><a href="/blog/">Blog</a><a href="/events/">Events</a><a href="/partners/">Partners</a><a href="/get-involved/">Get Involved</a><a href="/donate/">Donate</a></nav></header><main id="main"><section><h1>Keep the next cohort free.</h1><div class="row"><h2>$40</h2><p>One participant’s course materials for the full eight weeks.</p></div><div class="row"><h2>$90</h2><p>A term of transit stipends so a participant can actually get to training.</p></div><div class="row"><h2>$250</h2><p>The gear library: shared kit participants learn on and borrow for first calls.</p></div><h2>Monthly partners</h2><p>Keep the program free for the next cohort. Every amount is reported in our annual update: what came in, what it bought, who it trained.</p><p>A donation platform has not yet been selected. Contact us to discuss giving.</p><a href={"mailto:"+contactEmail}>Enquire about giving</a></section></main><footer><p>Training: Faithfire Production, 139 Millwick Dr, Toronto.</p><p>PictureThis Production is being set up as a nonprofit organization in Ontario.</p><p>Faithfire Production is its production arm.</p><a href="/policies/">Our standards & policies</a> · <a href={"mailto:"+contactEmail}>{contactEmail}</a> · Placeholder contact</footer></body></html>